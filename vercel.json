{
  "rewrites": [
    { "source": "/api/metrics/:id", "destination": "/api/metrics?id=:id" },
    { "source": "/api/meals/:id", "destination": "/api/meals?id=:id" },
    { "source": "/api/medications/:id", "destination": "/api/medications?id=:id" },
    { "source": "/api/workouts/:id", "destination": "/api/workouts?id=:id" },
    { "source": "/api/sleep-sessions/:id", "destination": "/api/sleep-sessions?id=:id" },
    { "source": "/api/health-episodes/:id", "destination": "/api/health-episodes?id=:id" },
    { "source": "/api/body-photos/:id", "destination": "/api/body-photos?id=:id" },
    { "source": "/api/entries/:id", "destination": "/api/entries?id=:id" },
    { "source": "/((?!api/|@)(?:[^.]*))", "destination": "/index.html" }
  ]
}
