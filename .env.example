# Supabase project settings (dashboard: Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend uses these (Vite only exposes vars prefixed with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Postgres connection strings (dashboard: Project Settings > Database)
# DATABASE_URL: pooled connection (Supavisor, port 6543) — used at runtime by api/
DATABASE_URL=
# DIRECT_URL: direct connection (port 5432) — used only by drizzle-kit for migrations
DIRECT_URL=
